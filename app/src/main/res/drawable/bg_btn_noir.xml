<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- التوهج الخارجي -->
    <item>
        <shape>
            <gradient
                android:startColor="#60D4AF37"
                android:endColor="#00D4AF37"
                android:type="radial"
                android:gradientRadius="80dp"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    
    <!-- الزر الأساسي -->
    <item android:top="4dp" android:bottom="4dp"
          android:left="4dp" android:right="4dp">
        <shape>
            <gradient
                android:startColor="#D4AF37"
                android:centerColor="#F4D97A"
                android:endColor="#D4AF37"
                android:angle="135"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#FFE8A0"/>
        </shape>
    </item>
</layer-list>
