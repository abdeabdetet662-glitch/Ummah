<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#0B4F2C"
                android:centerColor="#083A20"
                android:endColor="#052818"/>
            <stroke android:width="1.5dp" android:color="#D4AF37"/>
        </shape>
    </item>
    <item android:top="0dp" android:bottom="50%">
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#30D4AF37"
                android:endColor="#00D4AF37"/>
        </shape>
    </item>
</layer-list>
